rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'guna.chinnu07@gmail.com';
    }

    match /covers/{imageId} {
      // Public visitors can view uploaded article and project cover images
      allow read: if true;
      // Only the verified administrator can upload or delete images (max 5MB, image MIME types only)
      allow write: if isVerifiedAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
