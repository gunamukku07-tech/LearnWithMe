rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'guna.chinnu07@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Entity validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'updatedAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role == 'admin'
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidBlog(data) {
      return data.keys().hasAll([
          'title', 'slug', 'subtitle', 'description', 'content',
          'week', 'category', 'tags', 'coverImage', 'publicationDate',
          'readingTime', 'status', 'featured', 'isSample', 'keyTakeaways',
          'authorName', 'authorId'
        ])
        && data.keys().hasOnly([
          'title', 'slug', 'subtitle', 'description', 'content',
          'week', 'category', 'tags', 'coverImage', 'publicationDate',
          'readingTime', 'status', 'featured', 'isSample', 'keyTakeaways',
          'authorName', 'authorId'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 200
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.description is string && data.description.size() <= 600
        && data.content is string && data.content.size() <= 80000
        && data.week is number && data.week >= 1 && data.week <= 520
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 100
        && data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 60))
        && data.coverImage is string && data.coverImage.size() <= 2000
        && data.publicationDate is string && data.publicationDate.size() <= 64
        && data.readingTime is number && data.readingTime >= 1 && data.readingTime <= 180
        && data.status is string && (data.status == 'published' || data.status == 'draft')
        && data.featured is bool
        && data.isSample is bool
        && data.keyTakeaways is list && data.keyTakeaways.size() <= 15 && (data.keyTakeaways.size() == 0 || (data.keyTakeaways[0] is string && data.keyTakeaways[0].size() <= 400))
        && data.authorName is string && data.authorName.size() <= 120
        && data.authorId is string && data.authorId.size() <= 128 && data.authorId == request.auth.uid;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'description', 'icon'])
        && data.keys().hasOnly(['name', 'slug', 'description', 'icon'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.icon is string && data.icon.size() <= 60;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'description', 'technologies', 'coverImage', 'githubUrl', 'demoUrl', 'isDemo'])
        && data.keys().hasOnly(['name', 'description', 'technologies', 'coverImage', 'githubUrl', 'demoUrl', 'isDemo'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && data.description is string && data.description.size() <= 1000
        && data.technologies is list && data.technologies.size() <= 20 && (data.technologies.size() == 0 || (data.technologies[0] is string && data.technologies[0].size() <= 60))
        && data.coverImage is string && data.coverImage.size() <= 2000
        && data.githubUrl is string && data.githubUrl.size() <= 500
        && data.demoUrl is string && data.demoUrl.size() <= 500
        && data.isDemo is bool;
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'name', 'roleTitle', 'introduction', 'education',
          'learningPhilosophy', 'interests', 'skills', 'goals',
          'githubUrl', 'linkedinUrl', 'email'
        ])
        && data.keys().hasOnly([
          'name', 'roleTitle', 'introduction', 'education',
          'learningPhilosophy', 'interests', 'skills', 'goals',
          'githubUrl', 'linkedinUrl', 'email'
        ])
        && data.name is string && data.name.size() <= 120
        && data.roleTitle is string && data.roleTitle.size() <= 160
        && data.introduction is string && data.introduction.size() <= 2000
        && data.education is string && data.education.size() <= 1000
        && data.learningPhilosophy is string && data.learningPhilosophy.size() <= 1500
        && data.interests is list && data.interests.size() <= 20 && (data.interests.size() == 0 || (data.interests[0] is string && data.interests[0].size() <= 100))
        && data.skills is list && data.skills.size() <= 25 && (data.skills.size() == 0 || (data.skills[0] is string && data.skills[0].size() <= 100))
        && data.goals is list && data.goals.size() <= 15 && (data.goals.size() == 0 || (data.goals[0] is string && data.goals[0].size() <= 300))
        && data.githubUrl is string && data.githubUrl.size() <= 500
        && data.linkedinUrl is string && data.linkedinUrl.size() <= 500
        && data.email is string && data.email.size() <= 200;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'subscriptionDate', 'status'])
        && data.keys().hasOnly(['email', 'subscriptionDate', 'status'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 200 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.subscriptionDate is string && data.subscriptionDate.size() <= 64
        && data.status is string && data.status == 'active';
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt', 'status'])
        && data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'status'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 200 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 4000
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.status is string && (data.status == 'unread' || data.status == 'read');
    }

    // Admins lookup collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Users collection (Admin profiles)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isVerifiedAdmin());
      allow list: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isVerifiedAdmin() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming())
        && incoming().email == existing().email
        && incoming().role == existing().role;
      allow delete: if false;
    }

    // Blogs collection
    match /blogs/{blogId} {
      allow get: if isValidId(blogId) && (existing().status == 'published' || isVerifiedAdmin());
      allow list: if existing().status == 'published' || isVerifiedAdmin();
      allow create: if isVerifiedAdmin() && isValidId(blogId) && isValidBlog(incoming());
      allow update: if isVerifiedAdmin() && isValidId(blogId) && isValidBlog(incoming())
        && incoming().authorId == existing().authorId;
      allow delete: if isVerifiedAdmin() && isValidId(blogId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && existing().name is string;
      allow list: if existing().name is string;
      allow create: if isVerifiedAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isVerifiedAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isVerifiedAdmin() && isValidId(categoryId);
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && existing().name is string;
      allow list: if existing().name is string;
      allow create: if isVerifiedAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isVerifiedAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isVerifiedAdmin() && isValidId(projectId);
    }

    // Profile collection
    match /profile/{profileId} {
      allow get: if isValidId(profileId) && existing().name is string;
      allow list: if existing().name is string;
      allow create: if isVerifiedAdmin() && isValidId(profileId) && isValidProfile(incoming());
      allow update: if isVerifiedAdmin() && isValidId(profileId) && isValidProfile(incoming());
      allow delete: if isVerifiedAdmin() && isValidId(profileId);
    }

    // Subscribers collection (PII isolated: public create only, admin read/manage)
    match /subscribers/{subscriberId} {
      allow get: if isVerifiedAdmin() && isValidId(subscriberId);
      allow list: if isVerifiedAdmin();
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow update: if isVerifiedAdmin() && isValidId(subscriberId) && isValidSubscriber(incoming())
        && incoming().email == existing().email;
      allow delete: if isVerifiedAdmin() && isValidId(subscriberId);
    }

    // Contact messages collection (PII isolated: public create only, admin read/manage)
    match /contact_messages/{messageId} {
      allow get: if isVerifiedAdmin() && isValidId(messageId);
      allow list: if isVerifiedAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow update: if isVerifiedAdmin() && isValidId(messageId) && isValidContactMessage(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isVerifiedAdmin() && isValidId(messageId);
    }
  }
}
